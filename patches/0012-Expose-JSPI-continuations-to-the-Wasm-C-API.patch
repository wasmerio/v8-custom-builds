+      wasm_jspi_instance_new(raw_store, raw_module, &imports, nullptr)));
+  ASSERT_NE(nullptr, instance);
+  auto exports = instance->exports();
+  auto* store_impl = reinterpret_cast<::wasm::StoreImpl*>(store());
+  auto* isolate = store_impl->isolate();
