+TEST_F(WasmCapiTest, SynchronousFloatImportPreservesNanPayloads) {
+  ValueType types[] = {kWasmF32, kWasmF64, kWasmF32, kWasmF64};
+  FunctionSig sig(2, 2, types);
+  auto index = builder()->AddImport("echo", &sig);
+  uint8_t body[] = {
+      WASM_CALL_FUNCTION(index, WASM_LOCAL_GET(0), WASM_LOCAL_GET(1))};
+  AddExportedFunction("run", body, sizeof(body), &sig);
+  auto floats = [] {
+    return ownvec<ValType>::make(ValType::make(::wasm::ValKind::F32),
+                                 ValType::make(::wasm::ValKind::F64));
+  };
+  auto type = FuncType::make(floats(), floats());
+  auto echo =
+      Func::make(store(), type.get(),
+                 [](const vec<Val>& args, vec<Val>& results) -> own<Trap> {
+                   results[0] = Val(args[0].f32());
+                   results[1] = Val(args[1].f64());
+                   return nullptr;
+                 });
+  auto imports = vec<Extern*>::make(echo.get());
+  Instantiate(imports);
+  constexpr uint32_t bits32 = 0x7f800123;
+  constexpr uint64_t bits64 = 0x7ff0000000001234;
+  auto args = vec<Val>::make(Val(base::bit_cast<float>(bits32)),
+                             Val(base::bit_cast<double>(bits64)));
+  auto results = vec<Val>::make_uninitialized(2);
+  ASSERT_EQ(nullptr, GetExportedFunction(0)->call(args, results));
+  EXPECT_EQ(bits32, base::bit_cast<uint32_t>(results[0].f32()));
+  EXPECT_EQ(bits64, base::bit_cast<uint64_t>(results[1].f64()));
+}
