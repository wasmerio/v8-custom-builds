+  ASSERT_EQ(nullptr, wasm_promising_func_call(suspend_only_entry.get(), &empty,
+                                              &empty, &state.other));
+  ASSERT_NE(nullptr, state.other);
+  ASSERT_EQ(nullptr, wasm_promising_func_call(suspend_only_entry.get(), &empty,
+                                              &empty, &state.cancel));
+  ASSERT_NE(nullptr, state.cancel);
+  ASSERT_EQ(nullptr, wasm_pending_call_resume(&call, &empty, nullptr, &empty));
+  EXPECT_EQ(nullptr, call);
+  EXPECT_EQ(5, state.visits);
+  EXPECT_EQ(nullptr, state.cancel);
+  EXPECT_EQ(baseline + 1, isolate->wasm_stacks().size());
+  ASSERT_NE(nullptr, state.other);
+  ASSERT_EQ(nullptr,
+            wasm_pending_call_resume(&state.other, &empty, nullptr, &empty));
+  EXPECT_EQ(nullptr, state.other);
+  EXPECT_EQ(baseline, isolate->wasm_stacks().size());
+
+  state.fail = true;
+  auto* trap = wasm_promising_func_call(entry.get(), &empty, &empty, &call);
+  ASSERT_NE(nullptr, trap);
+  wasm_message_t message;
+  wasm_trap_message(trap, &message);
+  EXPECT_NE(std::string::npos,
+            std::string(message.data, message.size).find("host failure"));
+  wasm_byte_vec_delete(&message);
+  wasm_trap_delete(trap);
+  EXPECT_EQ(nullptr, call);
+  EXPECT_EQ(baseline, isolate->wasm_stacks().size());
+}
