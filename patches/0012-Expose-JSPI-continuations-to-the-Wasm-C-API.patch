+bool MatchesTypedValue(wasm::StoreImpl* store, const wasm_val_t& val,
+                       wasm::ValKind expected) {
+  if (val.kind != hide_valkind(expected)) return false;
+  if (!wasm::is_ref(expected) || !val.of.ref) return true;
+  auto ref = wasm::impl(reveal_ref(val.of.ref));
