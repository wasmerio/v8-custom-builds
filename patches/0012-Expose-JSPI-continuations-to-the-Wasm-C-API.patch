+TEST_F(WasmCapiTest, JspiInvalidImportSlot) {
+  FunctionSig sig(0, 0, nullptr);
+  builder()->AddImport("duplicate", &sig);
+  builder()->AddImport("duplicate", &sig);
+  builder()->AddImport("typed", wasm_i_i_sig());
+  Compile();
+  auto* raw_store = reinterpret_cast<wasm_store_t*>(store());
+  auto* raw_module = reinterpret_cast<wasm_module_t*>(module());
+  auto host =
+      Func::make(store(), cpp_i_i_sig(),
+                 [](const vec<Val>& args, vec<Val>& results) -> own<Trap> {
+                   results[0] = Val::i32(args[0].i32());
+                   return nullptr;
+                 });
+  auto expect_error = [&](wasm_extern_vec_t imports, const char* expected) {
+    wasm_trap_t* trap = nullptr;
+    EXPECT_EQ(nullptr,
+              wasm_jspi_instance_new(raw_store, raw_module, &imports, &trap));
+    ASSERT_NE(nullptr, trap);
+    wasm_message_t message;
+    wasm_trap_message(trap, &message);
+    EXPECT_NE(std::string::npos,
+              std::string(message.data, message.size).find(expected));
+    wasm_byte_vec_delete(&message);
+    wasm_trap_delete(trap);
+  };
+  auto* func = reinterpret_cast<wasm_extern_t*>(host.get());
+  wasm_extern_t* items[] = {func, func, func};
+  wasm_extern_vec_t imports = {3, items};
+  expect_error({0, nullptr}, "one null suspension slot");
+  expect_error(imports, "one null suspension slot");
+  items[2] = nullptr;
+  expect_error(imports, "() -> ()");
+  items[0] = nullptr;
+  expect_error(imports, "one null suspension slot");
+  items[2] = func;
+  expect_error(imports, "unique import name");
+  std::swap(items[0], items[1]);
+  expect_error(imports, "unique import name");
+}
