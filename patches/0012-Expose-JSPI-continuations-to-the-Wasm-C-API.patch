 TEST_F(WasmCapiTest, Recursion) {
   // Build the following function:
   // int32 fibonacci_wasm(int32 arg0) {
diff --git a/third_party/wasm-api/wasm.h b/third_party/wasm-api/wasm.h
index 8dad7d11c4..b97315bcc9 100644
--- a/third_party/wasm-api/wasm.h
+++ b/third_party/wasm-api/wasm.h
@@ -452,6 +452,50 @@ WASM_API_EXTERN size_t wasm_func_result_arity(const wasm_func_t*);
 WASM_API_EXTERN own wasm_trap_t* wasm_func_call(
   const wasm_func_t*, const wasm_val_vec_t* args, wasm_val_vec_t* results);
 
+// JS Promise Integration. All operations run on the store's owning thread.
+// Keep the store alive until every call is completed or deleted.
+// Each pending call owns its suspended stack independently.
+typedef struct wasm_pending_call_t wasm_pending_call_t;
+WASM_API_EXTERN bool wasm_func_belongs_to_store(const wasm_func_t*,
+                                                const wasm_store_t*);
+
+// A typed callback can set *pending to suspend. When pending is NULL the
+// caller is synchronous and the callback must complete before returning.
+typedef own wasm_trap_t* (*wasm_async_callback_t)(void* env,
+                                                  const wasm_val_vec_t* args,
+                                                  wasm_val_vec_t* results,
+                                                  bool* pending);
+// Returns NULL for a v128 parameter or result. On failure the caller retains
+// env.
+WASM_API_EXTERN own wasm_func_t* wasm_func_new_suspending(
+    wasm_store_t*, const wasm_functype_t*, wasm_async_callback_t, void* env,
+    void (*finalizer)(void*));
+
+// WebAssembly.promising(func). The reusable callable and each outstanding
+// invocation own their handles independently. The store must outlive both.
+typedef struct wasm_promising_func_t wasm_promising_func_t;
+// A v128 parameter or result is rejected. Floating-point values crossing the
+// JavaScript boundary follow JS Number conversions, including NaN handling.
+// A synchronous C import with v128 parameters or results traps if entered
+// from a secondary Wasm stack, before the host callback runs.
+WASM_API_EXTERN own wasm_promising_func_t* wasm_func_promising(
+    const wasm_func_t*, own wasm_trap_t** error);
+WASM_API_EXTERN void wasm_promising_func_delete(own wasm_promising_func_t*);
+
+// Vectors are borrowed for this turn. The caller provides one initialized
+// result slot per export result. A pending turn leaves those slots untouched.
+// A non-null call on success means suspension. NULL means completion.
+// Resume accepts the suspended import's results or a borrowed trap. Invalid
+// inputs and a suppressed checkpoint preserve the pending handle for retry.
+// The call output is required. Resume requires a live pending call.
+WASM_API_EXTERN own wasm_trap_t* wasm_promising_func_call(
+    const wasm_promising_func_t*, const wasm_val_vec_t* args,
+    wasm_val_vec_t* results, own wasm_pending_call_t**);
+WASM_API_EXTERN own wasm_trap_t* wasm_pending_call_resume(
+    own wasm_pending_call_t**, const wasm_val_vec_t* host_results,
+    const wasm_trap_t* error, wasm_val_vec_t* results);
+// Cancel a pending call. Its stack unwinds at the next allowed checkpoint.
+WASM_API_EXTERN void wasm_pending_call_delete(own wasm_pending_call_t*);
 
 // Global Instances
 
