+
+wasm_instance_t* wasm_jspi_instance_new(wasm_store_t* raw_store,
+                                        const wasm_module_t* module,
+                                        const wasm_extern_vec_t* imports,
+                                        wasm_trap_t** trap) {
+  auto store = wasm::impl(reveal_store(raw_store));
+  auto isolate = store->isolate();
+  v8::Isolate::Scope isolate_scope(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = store->context();
+  v8::Context::Scope context_scope(context);
+  v8::Local<v8::Object> suspender;
+  {
+    v8::TryCatch caught(isolate);
+    if (!NewSuspendingImport(store).ToLocal(&suspender)) {
+      if (trap)
+        *trap =
+            JspiFailure(store, caught, "could not create a suspending import");
+      return nullptr;
+    }
+  }
+  return NewInstance(raw_store, module, imports, trap,
+                     v8::Utils::OpenDirectHandle(*suspender));
+}
