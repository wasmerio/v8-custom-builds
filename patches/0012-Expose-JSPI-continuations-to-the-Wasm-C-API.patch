+TEST_F(WasmCapiTest, PromisingFunctionOwnsEachInvocation) {
+  auto isolate = reinterpret_cast<::wasm::StoreImpl*>(store())->i_isolate();
+  uint32_t index = builder()->AddImport("wait", wasm_i_i_sig());
+  uint8_t code[] = {
+      WASM_CALL_FUNCTION(index, WASM_CALL_FUNCTION(index, WASM_LOCAL_GET(0)))};
+  AddExportedFunction("run", code, sizeof(code), wasm_i_i_sig());
+
+  auto callback = [](void* env, const wasm_val_vec_t*, wasm_val_vec_t*,
+                     bool* pending) -> wasm_trap_t* {
+    auto isolate = static_cast<i::Isolate*>(env);
+    EXPECT_TRUE(isolate->IsOnCentralStack());
+    isolate->heap()->PreciseCollectAllGarbage(
+        GCFlag::kForced, GarbageCollectionReason::kTesting);
+    EXPECT_NE(nullptr, pending);
+    if (pending) *pending = true;
+    return nullptr;
+  };
+  auto type =
+      wasm_functype_new_1_1(wasm_valtype_new_i32(), wasm_valtype_new_i32());
+  auto host = wasm_func_new_suspending(reinterpret_cast<wasm_store_t*>(store()),
+                                       type, callback, isolate, nullptr);
+  wasm_functype_delete(type);
+  auto imports = vec<Extern*>::make(reinterpret_cast<Func*>(host));
+  Instantiate(imports);
+  wasm_func_delete(host);
+  wasm_trap_t* error = nullptr;
+  auto run = wasm_func_promising(
+      reinterpret_cast<wasm_func_t*>(GetExportedFunction(0)), &error);
+  ASSERT_NE(nullptr, run);
+  EXPECT_EQ(nullptr, error);
+  wasm_val_t arg = WASM_I32_VAL(40);
+  wasm_val_t result = WASM_I32_VAL(-1);
+  wasm_val_vec_t args{1, &arg}, results{1, &result};
+  wasm_pending_call_t *a = nullptr, *b = nullptr;
+  ASSERT_EQ(nullptr, wasm_promising_func_call(run, &args, &results, &a));
+  ASSERT_EQ(nullptr, wasm_promising_func_call(run, &args, &results, &b));
+  ASSERT_NE(nullptr, a);
+  ASSERT_NE(nullptr, b);
+  wasm_promising_func_delete(run);
+  wasm_pending_call_delete(a);
+  wasm_val_vec_t wrong = WASM_EMPTY_VEC;
+  error = wasm_pending_call_resume(&b, &wrong, nullptr, &results);
+  ASSERT_NE(nullptr, error);
+  wasm_trap_delete(error);
+  ASSERT_NE(nullptr, b);
+  ASSERT_EQ(nullptr, wasm_pending_call_resume(&b, &args, nullptr, &results));
+  ASSERT_NE(nullptr, b);
+  EXPECT_EQ(-1, result.of.i32);
+  arg.of.i32 = 42;
+  ASSERT_EQ(nullptr, wasm_pending_call_resume(&b, &args, nullptr, &results));
+  EXPECT_EQ(nullptr, b);
+  EXPECT_EQ(42, result.of.i32);
+}
