+// Each C API store uses its isolate's default queue.
+bool CanRunJspiTurn(wasm::StoreImpl* store) {
+  return store->i_isolate()->default_microtask_queue()->ShouldPerformCheckpoint(
+      store->isolate());
+}
+
+wasm_trap_t* JspiTrap(wasm::StoreImpl* store, v8::Local<v8::Value> exception) {
+  return release_trap(wasm::implement<wasm::Trap>::type::make(
+      store, wasm::GetProperException(
+                 store->i_isolate(), v8::Utils::OpenDirectHandle(*exception))));
+}
+
+wasm::own<wasm::Trap> JspiError(wasm::StoreImpl* store, const char* message) {
+  return wasm::Trap::make(wasm::seal<wasm::Store>(store),
+                          wasm::Message::make_nt(message));
+}
+
+wasm_trap_t* JspiFailure(wasm::StoreImpl* store, const v8::TryCatch& caught,
+                         const char* message) {
+  if (caught.HasCaught() && !caught.HasTerminated() &&
+      !caught.Exception().IsEmpty()) {
+    return JspiTrap(store, caught.Exception());
+  }
+  return release_trap(JspiError(store, message));
+}
+
+wasm_trap_t* FinishTurn(std::unique_ptr<wasm_pending_call_t>& call,
+                        wasm_pending_call_t** next) {
+  auto isolate = call->store->isolate();
+  isolate->PerformMicrotaskCheckpoint();
+  auto promise = call->completion.Get(isolate);
+  if (promise->State() == v8::Promise::kPending &&
+      !call->continuation.IsEmpty()) {
+    *next = call.release();
+    return nullptr;
+  }
+  if (promise->State() == v8::Promise::kFulfilled) return nullptr;
+  if (promise->State() == v8::Promise::kRejected) {
+    return JspiTrap(call->store, promise->Result());
+  }
+  return JspiTrap(call->store,
+                  v8::Exception::Error(v8::String::NewFromUtf8Literal(
+                      isolate, "Wasm suspended without a host continuation")));
+}
+
+v8::Local<v8::Value> HostResults(v8::Isolate*, const wasm::vec<wasm::Val>&);
+wasm_trap_t* ResumeGuest(std::unique_ptr<wasm_pending_call_t>& call,
+                         const wasm_trap_t* error, wasm_pending_call_t** next) {
+  auto store = call->store;
+  auto isolate = store->isolate();
+  v8::TryCatch caught(isolate);
+  auto resolver = call->continuation.Get(isolate);
+  call->continuation.Reset();
+  auto settled =
+      error
+          ? resolver->Reject(
+                store->context(),
+                v8::Utils::ToLocal(wasm::impl(reveal_trap(error))->v8_object()))
+          : resolver->Resolve(store->context(),
+                              HostResults(isolate, call->inputs));
+  if (!settled.FromMaybe(false))
+    return JspiFailure(store, caught, "could not resume Wasm continuation");
+  return FinishTurn(call, next);
+}
