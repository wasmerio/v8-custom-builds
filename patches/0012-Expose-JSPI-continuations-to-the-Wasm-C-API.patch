+// JS Promise Integration. All operations run on the store's owning thread.
+// Keep the store alive until every call is completed or deleted.
+// The suspender is a () -> () function. Calling it outside a promising Wasm
+// activation traps. Each pending call owns its suspended stack independently.
+typedef struct wasm_jspi_call_t wasm_jspi_call_t;
+WASM_API_EXTERN own wasm_func_t* wasm_jspi_suspender(wasm_store_t*);
+WASM_API_EXTERN bool wasm_func_belongs_to_store(
+  const wasm_func_t*, const wasm_store_t*);
+
+// Start a () -> () Wasm export, or resume it after its host future completes.
+// A non-null return is an owned trap. A null call on success means completion.
+// Both operations require a non-null output pointer. Resume also requires a
+// pending call. If a checkpoint is running or suppressed, start and resume
+// return a trap. In that case resume preserves the handle for retry. Otherwise it
+// consumes the old handle. Deletion unwinds the stack without running guest
+// code when the store drains microtasks. Deletion runs a checkpoint if allowed.
+WASM_API_EXTERN own wasm_trap_t* wasm_jspi_start(
+  const wasm_func_t*, own wasm_jspi_call_t** call);
+WASM_API_EXTERN own wasm_trap_t* wasm_jspi_resume(own wasm_jspi_call_t** call);
+WASM_API_EXTERN void wasm_jspi_call_delete(own wasm_jspi_call_t* call);
