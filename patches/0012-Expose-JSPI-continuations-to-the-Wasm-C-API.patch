+// JSPI only carries control. Embedders pass typed arguments and results
+// through ordinary Wasm functions, including values without a JS equivalent.
+struct wasm_jspi_call_t {
+  wasm::StoreImpl* store;
+  v8::Global<v8::Promise> completion;
+  v8::Global<v8::Promise::Resolver> continuation;
+};
+
+extern "C++" {
+namespace {
+struct JspiScope {
+  explicit JspiScope(wasm_jspi_call_t* call)
+      : active(call),
+        isolate(call->store->isolate()),
+        handles(call->store->isolate()),
+        context(call->store->context()),
+        vm(call->store->isolate()),
+        saved_policy(vm->GetMicrotasksPolicy()) {
+    vm->SetMicrotasksPolicy(v8::MicrotasksPolicy::kExplicit);
+  }
+  ~JspiScope() { vm->SetMicrotasksPolicy(saved_policy); }
+  ActiveJspiCall active;
+  v8::Isolate::Scope isolate;
+  v8::HandleScope handles;
+  v8::Context::Scope context;
+  v8::Isolate* vm;
+  v8::MicrotasksPolicy saved_policy;
+};
+
+v8::Local<v8::Function> WasmBuiltin(wasm::StoreImpl* store, const char* name) {
+  auto context = store->context();
+  auto isolate = store->isolate();
+  auto wasm =
+      context->Global()
+          ->Get(context, v8::String::NewFromUtf8Literal(isolate, "WebAssembly"))
+          .ToLocalChecked()
+          .As<v8::Object>();
+  return wasm
+      ->Get(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked())
+      .ToLocalChecked()
+      .As<v8::Function>();
+}
+
+void Suspend(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  auto isolate = info.GetIsolate();
+  auto call = active_jspi_call;
+  if (!call || call->store->isolate() != isolate) {
+    isolate->ThrowError("cannot suspend outside an asynchronous Wasm call");
+    return;
+  }
+  auto resolver =
+      v8::Promise::Resolver::New(isolate->GetCurrentContext()).ToLocalChecked();
+  call->continuation.Reset(isolate, resolver);
+  info.GetReturnValue().Set(resolver->GetPromise());
+}
+
+wasm_trap_t* JspiTrap(wasm::StoreImpl* store, v8::Local<v8::Value> exception) {
+  return release_trap(wasm::implement<wasm::Trap>::type::make(
+      store, wasm::GetProperException(
+                 store->i_isolate(), v8::Utils::OpenDirectHandle(*exception))));
+}
+
+wasm_trap_t* FinishTurn(wasm_jspi_call_t* call, wasm_jspi_call_t** next) {
+  auto isolate = call->store->isolate();
+  isolate->PerformMicrotaskCheckpoint();
+  auto promise = call->completion.Get(isolate);
+  if (promise->State() == v8::Promise::kPending &&
+      !call->continuation.IsEmpty()) {
+    *next = call;
+    return nullptr;
+  }
+  if (promise->State() == v8::Promise::kFulfilled)
+    return nullptr;
+  if (promise->State() == v8::Promise::kRejected) {
+    return JspiTrap(call->store, promise->Result());
+  }
+  return JspiTrap(call->store,
+                  v8::Exception::Error(v8::String::NewFromUtf8Literal(
+                      isolate, "Wasm suspended without a host continuation")));
+}
+}  // namespace
+}  // extern "C++"
+
+bool wasm_func_belongs_to_store(const wasm_func_t* func,
+                                const wasm_store_t* store) {
+  return wasm::impl(reveal_func(func))->store() ==
+         wasm::impl(reveal_store(store));
+}
+
+wasm_func_t* wasm_jspi_suspender(wasm_store_t* raw_store) {
+  auto store = wasm::impl(reveal_store(raw_store));
+  auto isolate = store->isolate();
+  v8::Isolate::Scope isolate_scope(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = store->context();
+  v8::Context::Scope context_scope(context);
+  v8::TryCatch caught(isolate);
+
+  // (module (import "e" "s" (func $s)) (func (export "run") call $s))
+  static constexpr uint8_t bytes[] = {
+      0, 97,  115, 109, 1, 0,   0,  0, 1, 4, 1, 96, 0, 0, 2,
+      7, 1,   1,   101, 1, 115, 0,  0, 3, 2, 1, 0,  7, 7, 1,
+      3, 114, 117, 110, 0, 1,   10, 6, 1, 4, 0, 16, 0, 11};
+  v8::Local<v8::WasmModuleObject> module;
+  if (!v8::WasmModuleObject::Compile(isolate, bytes).ToLocal(&module))
+    return nullptr;
+  v8::Local<v8::Value> callback =
+      v8::Function::New(context, Suspend).ToLocalChecked();
+  v8::Local<v8::Object> suspending;
+  if (!WasmBuiltin(store, "Suspending")
+           ->NewInstance(context, 1, &callback)
+           .ToLocal(&suspending))
+    return nullptr;
+  auto names = v8::Object::New(isolate);
+  auto imports = v8::Object::New(isolate);
+  names->Set(context, v8::String::NewFromUtf8Literal(isolate, "s"), suspending)
+      .Check();
+  imports->Set(context, v8::String::NewFromUtf8Literal(isolate, "e"), names)
+      .Check();
+  v8::Local<v8::Value> args[] = {module, imports};
+  v8::Local<v8::Object> instance;
+  if (!WasmBuiltin(store, "Instance")
+           ->NewInstance(context, 2, args)
+           .ToLocal(&instance)) {
+    return nullptr;
+  }
+  auto exports =
+      instance->Get(context, v8::String::NewFromUtf8Literal(isolate, "exports"))
+          .ToLocalChecked()
+          .As<v8::Object>();
+  auto run =
+      exports->Get(context, v8::String::NewFromUtf8Literal(isolate, "run"))
+          .ToLocalChecked()
+          .As<v8::Function>();
+  return release_func(wasm::implement<wasm::Func>::type::make(
+      store, v8::internal::Cast<v8::internal::JSFunction>(
+                 v8::Utils::OpenDirectHandle(*run))));
+}
+
+wasm_trap_t* wasm_jspi_start(const wasm_func_t* func, wasm_jspi_call_t** next) {
+  *next = nullptr;
+  auto f = wasm::impl(reveal_func(func));
+  auto call = std::make_unique<wasm_jspi_call_t>();
+  call->store = f->store();
+  JspiScope scope(call.get());
+  auto isolate = call->store->isolate();
+  auto context = call->store->context();
+  v8::TryCatch caught(isolate);
+  if (func->param_arity() != 0 || func->result_arity() != 0) {
+    return JspiTrap(call->store,
+                    v8::Exception::TypeError(v8::String::NewFromUtf8Literal(
+                        isolate, "JSPI entry must have type () -> ()")));
+  }
+  v8::Local<v8::Value> target = v8::Utils::ToLocal(f->v8_object());
+  v8::Local<v8::Value> wrapper, result;
+  if (!WasmBuiltin(call->store, "promising")
+           ->Call(context, v8::Undefined(isolate), 1, &target)
+           .ToLocal(&wrapper) ||
+      !wrapper.As<v8::Function>()
+           ->Call(context, v8::Undefined(isolate), 0, nullptr)
+           .ToLocal(&result)) {
+    return JspiTrap(call->store, caught.Exception());
+  }
+  call->completion.Reset(isolate, result.As<v8::Promise>());
+  auto trap = FinishTurn(call.get(), next);
+  if (*next)
+    call.release();
+  return trap;
+}
+
+wasm_trap_t* wasm_jspi_resume(wasm_jspi_call_t** next) {
+  std::unique_ptr<wasm_jspi_call_t> call(std::exchange(*next, nullptr));
+  JspiScope scope(call.get());
+  auto isolate = call->store->isolate();
+  auto resolver = call->continuation.Get(isolate);
+  call->continuation.Reset();
+  resolver->Resolve(call->store->context(), v8::Undefined(isolate)).Check();
+  auto trap = FinishTurn(call.get(), next);
+  if (*next)
+    call.release();
+  return trap;
+}
+
+void wasm_jspi_call_delete(wasm_jspi_call_t* call) {
+  delete call;
+}
