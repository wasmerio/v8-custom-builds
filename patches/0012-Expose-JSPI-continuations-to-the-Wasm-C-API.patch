+static wasm_func_t* NewSuspendingFunction(
+    wasm_store_t* store, const wasm_functype_t* type,
+    wasm_async_callback_t callback, wasm_async_callback_with_env_t with_env,
+    void* env, void (*finalizer)(void*)) {
+  auto store_impl = wasm::impl(reveal_store(store));
+  v8::Isolate::Scope scope(store_impl->isolate());
+  v8::HandleScope handles(store_impl->isolate());
+  if (HasSimdSignature(type) ||
+      store_impl->i_isolate()->native_context()->is_wasm_jspi_installed() ==
+          v8::internal::Smi::zero())
+    return nullptr;
+  auto data =
+      std::make_shared<wasm::FuncData>(store, type, wasm::FuncData::kAsync);
+  data->async_callback = {callback, with_env};
+  data->env = env;
+  auto function = wasm::make_func(store, data);
+  if (function) data->finalizer = finalizer;
+  return release_func(std::move(function));
+}
