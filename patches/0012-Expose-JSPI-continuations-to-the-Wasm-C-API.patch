+bool wasm_trap_is_suspend_error(const wasm_trap_t* trap) {
+  auto value = wasm::impl(reveal_trap(trap));
+  auto store = value->store();
+  v8::Isolate::Scope scope(store->isolate());
+  v8::internal::HandleScope handles(store->i_isolate());
+  auto context = store->i_isolate()->native_context();
+  if (context->is_wasm_jspi_installed() == v8::internal::Smi::zero())
+    return false;
+  auto constructor = context->wasm_suspend_error_function();
+  return value->v8_object()->map()->prototype() ==
+         constructor->instance_prototype();
+}
