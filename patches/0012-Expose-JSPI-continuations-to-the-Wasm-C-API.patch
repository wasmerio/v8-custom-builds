+// JSPI only carries control. Embedders pass typed arguments and results
+// through ordinary Wasm functions, including values without a JS equivalent.
+struct wasm_jspi_call_t {
+  wasm::StoreImpl* store;
+  v8::Global<v8::Promise> completion;
+  v8::Global<v8::Promise::Resolver> continuation;
+};
+
+extern "C++" {
+namespace {
+struct JspiScope {
+  explicit JspiScope(wasm_jspi_call_t* call)
+      : active(call),
+        isolate(call->store->isolate()),
+        handles(call->store->isolate()),
+        context(call->store->context()),
+        vm(call->store->isolate()),
+        saved_policy(vm->GetMicrotasksPolicy()) {
+    vm->SetMicrotasksPolicy(v8::MicrotasksPolicy::kExplicit);
+  }
+  ~JspiScope() { vm->SetMicrotasksPolicy(saved_policy); }
+  ActiveJspiCall active;
+  v8::Isolate::Scope isolate;
+  v8::HandleScope handles;
+  v8::Context::Scope context;
+  v8::Isolate* vm;
+  v8::MicrotasksPolicy saved_policy;
+};
+
+// Each C API store uses its isolate's default queue.
+bool CanRunJspiTurn(wasm::StoreImpl* store) {
+  return store->i_isolate()->default_microtask_queue()->ShouldPerformCheckpoint(
+      store->isolate());
+}
+
+template <int N>
+v8::MaybeLocal<v8::Function> WasmBuiltin(wasm::StoreImpl* store,
+                                         const char (&name)[N]) {
+  auto context = store->context();
+  auto isolate = store->isolate();
+  v8::Local<v8::Value> wasm, builtin;
+  if (!context->Global()
+           ->Get(context,
+                 v8::String::NewFromUtf8Literal(isolate, "WebAssembly"))
+           .ToLocal(&wasm) ||
+      !wasm->IsObject() ||
+      !wasm.As<v8::Object>()
+           ->Get(context, v8::String::NewFromUtf8Literal(isolate, name))
+           .ToLocal(&builtin) ||
+      !builtin->IsFunction()) {
+    return {};
+  }
+  return builtin.As<v8::Function>();
+}
+
+v8::MaybeLocal<v8::Function> PromisingEntry(wasm::StoreImpl* store,
+                                            v8::Local<v8::Object> entry) {
+  auto isolate = store->isolate();
+  auto context = store->context();
+  auto key = v8::Private::ForApi(
+      isolate, v8::String::NewFromUtf8Literal(isolate, "wasm.c-api.promising"));
+  v8::Local<v8::Value> wrapper;
+  if (!entry->GetPrivate(context, key).ToLocal(&wrapper)) return {};
+  if (wrapper->IsFunction()) return wrapper.As<v8::Function>();
+  v8::Local<v8::Function> promising;
+  v8::Local<v8::Value> target = entry;
+  if (!WasmBuiltin(store, "promising").ToLocal(&promising) ||
+      !promising->Call(context, v8::Undefined(isolate), 1, &target)
+           .ToLocal(&wrapper) ||
+      !wrapper->IsFunction() ||
+      !entry->SetPrivate(context, key, wrapper).FromMaybe(false)) {
+    return {};
+  }
+  return wrapper.As<v8::Function>();
+}
+
+void Suspend(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  auto isolate = info.GetIsolate();
+  auto call = active_jspi_call;
+  if (!call || call->store->isolate() != isolate) {
+    isolate->ThrowError("cannot suspend outside an asynchronous Wasm call");
+    return;
+  }
+  if (!call->continuation.IsEmpty()) {
+    isolate->ThrowError("Wasm call already has a pending continuation");
+    return;
+  }
+  v8::Local<v8::Promise::Resolver> resolver;
+  if (!v8::Promise::Resolver::New(isolate->GetCurrentContext())
+           .ToLocal(&resolver))
+    return;
+  call->continuation.Reset(isolate, resolver);
+  info.GetReturnValue().Set(resolver->GetPromise());
+}
+
+v8::MaybeLocal<v8::Object> NewSuspendingImport(wasm::StoreImpl* store) {
+  auto context = store->context();
+  v8::Local<v8::Function> constructor, callback;
+  if (!WasmBuiltin(store, "Suspending").ToLocal(&constructor) ||
+      !v8::Function::New(context, Suspend).ToLocal(&callback))
+    return {};
+  v8::Local<v8::Value> arg = callback;
+  return constructor->NewInstance(context, 1, &arg);
+}
+
+wasm_trap_t* JspiTrap(wasm::StoreImpl* store, v8::Local<v8::Value> exception) {
+  return release_trap(wasm::implement<wasm::Trap>::type::make(
+      store, wasm::GetProperException(
+                 store->i_isolate(), v8::Utils::OpenDirectHandle(*exception))));
+}
+
+wasm::own<wasm::Trap> JspiError(wasm::StoreImpl* store, const char* message) {
+  return wasm::Trap::make(wasm::seal<wasm::Store>(store),
+                          wasm::Message::make_nt(message));
+}
+
+wasm_trap_t* JspiFailure(wasm::StoreImpl* store, const v8::TryCatch& caught,
+                         const char* message) {
+  if (caught.HasCaught() && !caught.HasTerminated() &&
+      !caught.Exception().IsEmpty()) {
+    return JspiTrap(store, caught.Exception());
+  }
+  return release_trap(JspiError(store, message));
+}
+
+wasm_trap_t* FinishTurn(wasm_jspi_call_t* call, wasm_jspi_call_t** next) {
+  auto isolate = call->store->isolate();
+  isolate->PerformMicrotaskCheckpoint();
+  auto promise = call->completion.Get(isolate);
+  if (promise->State() == v8::Promise::kPending &&
+      !call->continuation.IsEmpty()) {
+    *next = call;
+    return nullptr;
+  }
+  if (promise->State() == v8::Promise::kFulfilled) return nullptr;
+  if (promise->State() == v8::Promise::kRejected) {
+    return JspiTrap(call->store, promise->Result());
+  }
+  return JspiTrap(call->store,
+                  v8::Exception::Error(v8::String::NewFromUtf8Literal(
+                      isolate, "Wasm suspended without a host continuation")));
+}
+}  // namespace
+}  // extern "C++"
+
+bool wasm_func_belongs_to_store(const wasm_func_t* func,
+                                const wasm_store_t* store) {
+  return wasm::impl(reveal_func(func))->store() ==
+         wasm::impl(reveal_store(store));
+}
+
+wasm_trap_t* wasm_jspi_start(const wasm_func_t* func, wasm_jspi_call_t** next) {
+  *next = nullptr;
+  auto f = wasm::impl(reveal_func(func));
+  auto call = std::make_unique<wasm_jspi_call_t>();
+  call->store = f->store();
+  JspiScope scope(call.get());
+  auto isolate = call->store->isolate();
+  auto context = call->store->context();
+  v8::TryCatch caught(isolate);
+  if (func->param_arity() != 0 || func->result_arity() != 0) {
+    return JspiTrap(call->store,
+                    v8::Exception::TypeError(v8::String::NewFromUtf8Literal(
+                        isolate, "JSPI entry must have type () -> ()")));
+  }
+  if (!CanRunJspiTurn(call->store)) {
+    return release_trap(JspiError(
+        call->store,
+        "cannot start Wasm during a suppressed or running checkpoint"));
+  }
+  v8::Local<v8::Function> wrapper;
+  v8::Local<v8::Value> result;
+  if (!PromisingEntry(call->store, v8::Utils::ToLocal(f->v8_object()))
+           .ToLocal(&wrapper) ||
+      !wrapper->Call(context, v8::Undefined(isolate), 0, nullptr)
+           .ToLocal(&result) ||
+      !result->IsPromise()) {
+    return JspiFailure(call->store, caught,
+                       "could not start promising Wasm entry");
+  }
+  call->completion.Reset(isolate, result.As<v8::Promise>());
+  auto trap = FinishTurn(call.get(), next);
+  if (*next) call.release();
+  return trap;
+}
+
+wasm_trap_t* wasm_jspi_resume(wasm_jspi_call_t** next) {
+  JspiScope scope(*next);
+  auto isolate = (*next)->store->isolate();
+  if (!CanRunJspiTurn((*next)->store)) {
+    return release_trap(JspiError(
+        (*next)->store,
+        "cannot resume Wasm during a suppressed or running checkpoint"));
+  }
+  std::unique_ptr<wasm_jspi_call_t> call(std::exchange(*next, nullptr));
+  v8::TryCatch caught(isolate);
+  auto resolver = call->continuation.Get(isolate);
+  call->continuation.Reset();
+  if (!resolver->Resolve(call->store->context(), v8::Undefined(isolate))
+           .FromMaybe(false)) {
+    return JspiFailure(call->store, caught,
+                       "could not resume Wasm continuation");
+  }
+  auto trap = FinishTurn(call.get(), next);
+  if (*next) call.release();
+  return trap;
+}
+
+void wasm_jspi_call_delete(wasm_jspi_call_t* call) {
+  if (!call) return;
+  std::unique_ptr<wasm_jspi_call_t> owned(call);
+  JspiScope scope(call);
+  auto isolate = call->store->isolate();
+  auto error = JspiError(call->store, "Wasm call cancelled");
+  auto resolver = call->continuation.Get(isolate);
+  call->completion.Get(isolate)->MarkAsHandled();
+  // Trap::make marks the rejection uncatchable by Wasm. Unwinding returns
+  // the suspended stack to V8's pool without invoking guest catch handlers.
+  // Inside a microtask, the running checkpoint processes this rejection.
+  if (resolver
+          ->Reject(call->store->context(),
+                   v8::Utils::ToLocal(wasm::impl(error.get())->v8_object()))
+          .FromMaybe(false)) {
+    isolate->PerformMicrotaskCheckpoint();
+  }
+}
