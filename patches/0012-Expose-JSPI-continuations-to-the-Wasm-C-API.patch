+wasm_promising_func_t* wasm_func_promising(const wasm_func_t* func,
+                                           wasm_trap_t** error) {
+  if (error) *error = nullptr;
+  auto target = std::make_shared<PromisingTarget>();
+  target->function = func->copy();
+  target->type = func->type();
+  auto f = wasm::impl(reveal_func(func));
+  auto store = f->store();
+  v8::Isolate::Scope isolate_scope(store->isolate());
+  v8::HandleScope handles(store->isolate());
+  v8::Context::Scope context(store->context());
+  if (HasSimdSignature(target->type.get())) {
+    if (error)
+      *error = release_trap(JspiError(
+          store, "V8 JSPI does not support v128 parameters or results"));
+    return nullptr;
+  }
+  if (!vi::WasmCapiFunction::IsWasmCapiFunction(*f->v8_object())) {
+    if (store->i_isolate()->native_context()->is_wasm_jspi_installed() ==
+        vi::Smi::zero()) {
+      if (error)
+        *error =
+            release_trap(JspiError(store, "JSPI is unavailable in this store"));
+      return nullptr;
+    }
+    auto isolate = store->i_isolate();
+    auto data = vi::direct_handle(
+        f->v8_object()->shared()->wasm_exported_function_data(), isolate);
+    if (!vw::IsJSCompatibleSignature(data->internal()->sig())) {
+      if (error)
+        *error = release_trap(JspiError(
+            store, "function signature is incompatible with JavaScript"));
+      return nullptr;
+    }
+    target->js_entry.Reset(
+        store->isolate(),
+        v8::Utils::ToLocal(vi::NewPromisingWasmFunction(isolate, data)));
+  }
+  return new wasm_promising_func_t{std::move(target)};
+}
+
+void wasm_promising_func_delete(wasm_promising_func_t* func) { delete func; }
+
+wasm_trap_t* wasm_promising_func_call(const wasm_promising_func_t* promising,
+                                      const wasm_val_vec_t* args,
+                                      wasm_val_vec_t* results,
+                                      wasm_pending_call_t** next) {
+  *next = nullptr;
+  auto call = std::make_unique<wasm_pending_call_t>();
+  call->target = promising->target;
+  auto func = call->target->function.get();
+  auto ty = call->target->type.get();
+  call->store = wasm::impl(func)->store();
+  JspiScope scope(call.get());
+  if (!results || results->size != ty->results().size() ||
+      (results->size && !results->data) ||
+      !CopyTypedValues(call->store, args, ty->params(), &call->inputs))
+    return release_trap(JspiError(
+        call->store, "incorrect async call arguments or result slots"));
+  if (!CanRunJspiTurn(call->store))
+    return release_trap(JspiError(
+        call->store,
+        "cannot start Wasm during a suppressed or running checkpoint"));
+  call->returned = wasm::vec<wasm::Val>::make_uninitialized(results->size);
+  auto obj = wasm::impl(func)->v8_object();
+  if (vi::WasmCapiFunction::IsWasmCapiFunction(*obj)) {
+    auto data = obj->shared()->wasm_capi_function_data();
+    auto host =
+        vi::Cast<vi::CppGCManaged<wasm::FuncData>>(data->embedder_data())
+            ->ptr();
+    bool pending = false;
+    ActiveJspiCall sync_callback(nullptr);
+    auto trap =
+        host->kind == wasm::FuncData::kAsync
+            ? host->InvokeAsync(call->inputs, call->returned, &pending)
+            : wasm::CallWasmCapiFunction(data, call->inputs, call->returned);
+    if (trap) return release_trap(std::move(trap));
+    if (pending) {
+      call->suspended_type = ty->copy();
+      *next = call.release();
+      return nullptr;
+    }
+  } else {
+    v8::TryCatch caught(call->store->isolate());
+    v8::Local<v8::Value> result;
+    auto isolate = call->store->isolate();
+    v8::LocalVector<v8::Value> argv(isolate);
+    argv.reserve(call->inputs.size());
+    for (size_t i = 0; i < call->inputs.size(); ++i) {
+      argv.push_back(JSArgument(isolate, call->inputs[i]));
+    }
+    if (!call->target->js_entry.Get(isolate)
+             ->Call(call->store->context(), v8::Undefined(isolate),
+                    static_cast<int>(argv.size()), argv.data())
+             .ToLocal(&result) ||
+        !result->IsPromise())
+      return JspiFailure(call->store, caught,
+                         "could not call promising Wasm export");
+    call->completion.Reset(call->store->isolate(), result.As<v8::Promise>());
+    auto trap = FinishTurn(call, next);
+    if (trap || !call) return trap;
+  }
+  return ReturnTypedValues(call.get(), results);
+}
+
+wasm_trap_t* wasm_pending_call_resume(wasm_pending_call_t** next,
+                                      const wasm_val_vec_t* host_results,
+                                      const wasm_trap_t* error,
+                                      wasm_val_vec_t* results) {
+  auto pending = *next;
+  JspiScope scope(pending);
+  auto store = pending->store;
+  if (!CanRunJspiTurn(store))
+    return release_trap(JspiError(
+        store, "cannot resume Wasm during a suppressed or running checkpoint"));
+  if (!pending->suspended_type || !results ||
+      results->size != pending->returned.size() ||
+      (results->size && !results->data) ||
+      (error && wasm::impl(reveal_trap(error))->store() != store) ||
+      (!error &&
+       !CopyTypedValues(store, host_results, pending->suspended_type->results(),
+                        &pending->inputs)))
+    return release_trap(
+        JspiError(store, "incorrect async host results or result slots"));
+  std::unique_ptr<wasm_pending_call_t> call(std::exchange(*next, nullptr));
+  call->suspended_type.reset();
+  if (call->completion.IsEmpty()) {
+    if (error) return release_trap(error->copy());
+    call->returned = std::move(call->inputs);
+  } else {
+    auto trap = ResumeGuest(call, error, next);
+    if (trap || !call) return trap;
+  }
+  return ReturnTypedValues(call.get(), results);
+}
+
+void wasm_pending_call_delete(wasm_pending_call_t* call) {
+  if (!call) return;
+  std::unique_ptr<wasm_pending_call_t> owned(call);
+  JspiScope scope(call);
+  if (call->completion.IsEmpty()) return;
+  auto isolate = call->store->isolate();
+  auto error = JspiError(call->store, "Wasm call cancelled");
+  auto resolver = call->continuation.Get(isolate);
+  call->completion.Get(isolate)->MarkAsHandled();
+  // Trap::make marks the rejection uncatchable by Wasm. Unwinding returns
+  // the suspended stack to V8's pool without invoking guest catch handlers.
+  // Inside a microtask, the running checkpoint processes this rejection.
+  if (resolver
+          ->Reject(call->store->context(),
+                   v8::Utils::ToLocal(wasm::impl(error.get())->v8_object()))
+          .FromMaybe(false)) {
+    isolate->PerformMicrotaskCheckpoint();
+  }
+}
