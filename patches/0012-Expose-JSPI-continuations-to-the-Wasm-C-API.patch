+wasm_trap_t* FinishTurn(std::unique_ptr<wasm_pending_call_t>& call,
+                        wasm_pending_call_t** next) {
+  auto isolate = call->store->isolate();
+  isolate->PerformMicrotaskCheckpoint();
+  auto promise = call->completion.Get(isolate);
+  if (promise->State() == v8::Promise::kPending &&
+      !call->continuation.IsEmpty()) {
+    *next = call.release();
+    return nullptr;
+  }
+  if (promise->State() == v8::Promise::kFulfilled) return nullptr;
+  if (promise->State() == v8::Promise::kRejected) {
+    return JspiTrap(call->store, promise->Result());
+  }
+  return JspiTrap(call->store,
+                  v8::Exception::Error(v8::String::NewFromUtf8Literal(
+                      isolate, "Wasm suspended without a host continuation")));
+}
