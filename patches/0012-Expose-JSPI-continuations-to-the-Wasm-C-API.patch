+wasm::own<wasm::Trap> ReadJSResults(wasm::StoreImpl* store,
+                                    v8::Local<v8::Value> result,
+                                    const wasm::ownvec<wasm::ValType>& types,
+                                    wasm::vec<wasm::Val>& values) {
+  for (size_t i = 0; i < types.size(); ++i) {
+    auto value = result;
+    if (types.size() > 1 &&
+        !result.As<v8::Array>()
+             ->Get(store->context(), static_cast<uint32_t>(i))
+             .ToLocal(&value)) {
+      return JspiError(store, "could not read Wasm results");
+    }
+    if (auto error = FromJS(store, value, types[i]->kind(), values[i]))
+      return error;
+  }
+  return nullptr;
+}
+
+wasm_trap_t* ReturnTypedValues(wasm_pending_call_t* call, wasm_val_vec_t* out) {
+  if (!call->completion.IsEmpty()) {
+    if (auto error = ReadJSResults(
+            call->store, call->completion.Get(call->store->isolate())->Result(),
+            call->target->type->results(), call->returned))
+      return release_trap(std::move(error));
+  }
+  for (size_t i = 0; i < out->size; ++i) {
+    wasm_val_delete(&out->data[i]);
+    out->data[i] = release_val(std::move(call->returned[i]));
+    out->data[i].kind = hide_valkind(call->target->type->results()[i]->kind());
+  }
+  return nullptr;
+}
+
+v8::Local<v8::Value> JSArgument(v8::Isolate* isolate, const wasm::Val& arg) {
+  switch (arg.kind()) {
+    case wasm::ValKind::I32:
+      return v8::Integer::New(isolate, arg.i32());
+    case wasm::ValKind::I64:
+      return v8::BigInt::New(isolate, arg.i64());
+    case wasm::ValKind::F32:
+      return v8::Number::New(isolate, arg.f32());
+    case wasm::ValKind::F64:
+      return v8::Number::New(isolate, arg.f64());
+    case wasm::ValKind::FUNCREF:
+    case wasm::ValKind::EXTERNREF:
+      if (!arg.ref()) return v8::Null(isolate);
+      return v8::Utils::ToLocal(wasm::impl(arg.ref())->v8_object());
+    default:
+      UNREACHABLE();
+  }
+}
+v8::MaybeLocal<v8::Value> CallJSEntry(wasm::StoreImpl* store,
+                                      v8::Local<v8::Function> entry,
+                                      const wasm::vec<wasm::Val>& args) {
+  auto isolate = store->isolate();
+  v8::LocalVector<v8::Value> argv(isolate);
+  argv.reserve(args.size());
+  for (size_t i = 0; i < args.size(); ++i)
+    argv.push_back(JSArgument(isolate, args[i]));
+  return entry->Call(store->context(), v8::Undefined(isolate),
+                     static_cast<int>(argv.size()), argv.data());
+}
+
+v8::Local<v8::Value> HostResults(v8::Isolate* isolate,
+                                 const wasm::vec<wasm::Val>& values) {
+  v8::Local<v8::Value> result = v8::Undefined(isolate);
+  if (values.size() == 1) {
+    result = JSArgument(isolate, values[0]);
+  } else if (values.size() > 1) {
+    v8::LocalVector<v8::Value> elements(isolate);
+    for (size_t i = 0; i < values.size(); ++i) {
+      elements.push_back(JSArgument(isolate, values[i]));
+    }
+    result = v8::Array::New(isolate, elements.data(), elements.size());
+  }
+  return result;
+}
