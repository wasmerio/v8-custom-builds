+bool CopyTypedValues(wasm::StoreImpl* store, const wasm_val_vec_t* source,
+                     const wasm::ownvec<wasm::ValType>& types,
+                     wasm::vec<wasm::Val>* dest) {
+  if (!source || source->size != types.size() ||
+      (source->size && !source->data))
+    return false;
+  auto copy = wasm::vec<wasm::Val>::make_uninitialized(types.size());
+  for (size_t i = 0; i < types.size(); ++i) {
+    const auto& val = source->data[i];
+    if (!MatchesTypedValue(store, val, types[i]->kind())) return false;
+    if (types[i]->is_ref()) {
+      copy[i] = wasm::Val::ref(types[i]->kind(),
+                               val.of.ref ? val.of.ref->copy() : nullptr);
+    } else {
+      copy[i] = adopt_val(val);
+    }
+  }
+  *dest = std::move(copy);
+  return true;
+}
+
+wasm::own<wasm::Trap> FromJS(wasm::StoreImpl* store, v8::Local<v8::Value> value,
+                             wasm::ValKind kind, wasm::Val& out,
+                             bool host = false) {
+  switch (kind) {
+    case wasm::ValKind::I32:
+      out = wasm::Val(value.As<v8::Int32>()->Value());
+      break;
+    case wasm::ValKind::I64:
+      out = wasm::Val(value.As<v8::BigInt>()->Int64Value());
+      break;
+    case wasm::ValKind::F32:
+      out = wasm::Val(
+          host ? v8::base::bit_cast<float>(value.As<v8::Int32>()->Value())
+               : static_cast<float>(value.As<v8::Number>()->Value()));
+      break;
+    case wasm::ValKind::F64:
+      out = wasm::Val(host ? v8::base::bit_cast<double>(
+                                 value.As<v8::BigInt>()->Int64Value())
+                           : value.As<v8::Number>()->Value());
+      break;
+    case wasm::ValKind::FUNCREF:
+    case wasm::ValKind::EXTERNREF:
+      if (!value->IsNull() && !value->IsObject())
+        return JspiError(store,
+                         "C API reference result must be an object or null");
+      out = wasm::Val::ref(
+          kind,
+          wasm::V8RefValueToWasm(store, v8::Utils::OpenDirectHandle(*value)));
+      break;
+    default:
+      UNREACHABLE();
+  }
+  return nullptr;
+}
+
+// JSPI fulfills its promise with undefined, one value, or a packed array.
+wasm_trap_t* ReturnTypedValues(wasm_pending_call_t* call, wasm_val_vec_t* out) {
+  if (!call->completion.IsEmpty()) {
+    auto result = call->completion.Get(call->store->isolate())->Result();
+    auto& types = call->target->type->results();
+    for (size_t i = 0; i < types.size(); ++i) {
+      auto value = result;
+      if (types.size() > 1 &&
+          !result.As<v8::Array>()
+               ->Get(call->store->context(), static_cast<uint32_t>(i))
+               .ToLocal(&value))
+        return release_trap(
+            JspiError(call->store, "could not read promising results"));
+      auto kind = types[i]->kind();
+      if (auto error = FromJS(call->store, value, kind, call->returned[i]))
+        return release_trap(std::move(error));
+    }
+  }
+  for (size_t i = 0; i < out->size; ++i) {
+    wasm_val_delete(&out->data[i]);
+    out->data[i] = release_val(std::move(call->returned[i]));
+  }
+  return nullptr;
+}
+
+v8::Local<v8::Value> JSArgument(v8::Isolate* isolate, const wasm::Val& arg,
+                                bool host = false) {
+  switch (arg.kind()) {
+    case wasm::ValKind::I32:
+      return v8::Integer::New(isolate, arg.i32());
+    case wasm::ValKind::I64:
+      return v8::BigInt::New(isolate, arg.i64());
+    case wasm::ValKind::F32:
+      if (host)
+        return v8::Integer::New(isolate,
+                                v8::base::bit_cast<int32_t>(arg.f32()));
+      return v8::Number::New(isolate, arg.f32());
+    case wasm::ValKind::F64:
+      if (host)
+        return v8::BigInt::New(isolate, v8::base::bit_cast<int64_t>(arg.f64()));
+      return v8::Number::New(isolate, arg.f64());
+    case wasm::ValKind::FUNCREF:
+    case wasm::ValKind::EXTERNREF:
+      if (!arg.ref()) return v8::Null(isolate);
+      return v8::Utils::ToLocal(wasm::impl(arg.ref())->v8_object());
+    default:
+      UNREACHABLE();
+  }
+}
+v8::Local<v8::Array> BoxHostResults(v8::Isolate* isolate,
+                                    const wasm::vec<wasm::Val>& values) {
+  v8::Local<v8::Value> result = v8::Undefined(isolate);
+  if (values.size() == 1) {
+    result = JSArgument(isolate, values[0], true);
+  } else if (values.size() > 1) {
+    v8::LocalVector<v8::Value> elements(isolate);
+    for (size_t i = 0; i < values.size(); ++i) {
+      elements.push_back(JSArgument(isolate, values[i], true));
+    }
+    result = v8::Array::New(isolate, elements.data(), elements.size());
+  }
+  // Keep externref promises as values, including when resolving a continuation.
+  return v8::Array::New(isolate, &result, 1);
+}
