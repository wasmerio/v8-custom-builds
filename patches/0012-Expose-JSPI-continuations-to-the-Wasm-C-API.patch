+TEST_F(WasmCapiTest, PromisingScalarResults) {
+  ValueType types[]{kWasmI32, kWasmI64, kWasmF64,    kWasmFuncRef,
+                    kWasmF32, kWasmI64, kWasmFuncRef};
+  FunctionSig scalar(4, 3, types);
+  uint8_t body[]{WASM_I32_REINTERPRET_F32(WASM_LOCAL_GET(0)), WASM_LOCAL_GET(1),
+                 WASM_F64_REINTERPRET_I64(WASM_LOCAL_GET(1)),
+                 WASM_LOCAL_GET(2)};
+  AddExportedFunction("mixed", body, sizeof(body), &scalar);
+  ValueType floats[]{kWasmF32, kWasmI32};
+  FunctionSig floating(1, 1, floats);
+  uint8_t f32_body[]{WASM_F32_REINTERPRET_I32(WASM_LOCAL_GET(0))};
+  AddExportedFunction("float", f32_body, sizeof(f32_body), &floating);
+  auto imports = vec<Extern*>::make();
+  Instantiate(imports);
+  auto run = wasm_func_promising(
+      reinterpret_cast<wasm_func_t*>(GetExportedFunction(0)), nullptr);
+  ASSERT_NE(nullptr, run);
+  constexpr uint64_t payload64 = 0x7ff0000000001234;
+  constexpr uint32_t payload32 = 0x7f800123;
+  wasm_val_t inputs[] = {
+      WASM_F32_VAL(-0.0f), WASM_I64_VAL(payload64),
+      WASM_REF_VAL(wasm_func_as_ref(
+          reinterpret_cast<wasm_func_t*>(GetExportedFunction(1))))};
+  inputs[2].kind = WASM_FUNCREF;
+  wasm_val_t outputs[4]{};
+  wasm_val_vec_t args = WASM_ARRAY_VEC(inputs),
+                 results = WASM_ARRAY_VEC(outputs);
+  wasm_pending_call_t* pending = nullptr;
+  ASSERT_EQ(nullptr, wasm_promising_func_call(run, &args, &results, &pending));
+  ASSERT_EQ(nullptr, pending);
+  EXPECT_EQ(INT32_MIN, outputs[0].of.i32);
+  EXPECT_EQ(static_cast<int64_t>(payload64), outputs[1].of.i64);
+  EXPECT_TRUE(std::isnan(outputs[2].of.f64));
+
+  ASSERT_EQ(WASM_FUNCREF, outputs[3].kind);
+  EXPECT_TRUE(wasm_ref_same(inputs[2].of.ref, outputs[3].of.ref));
+  inputs[0].of.f32 = base::bit_cast<float>(payload32);
+  ASSERT_EQ(nullptr, wasm_promising_func_call(run, &args, &results, &pending));
+  EXPECT_TRUE(std::isnan(base::bit_cast<float>(outputs[0].of.i32)));
+  wasm_promising_func_delete(run);
+  wasm_val_delete(&outputs[3]);
+
+  run = wasm_func_promising(
+      reinterpret_cast<wasm_func_t*>(GetExportedFunction(1)), nullptr);
+  ASSERT_NE(nullptr, run);
+  wasm_val_t bits = WASM_I32_VAL(payload32), out{};
+  wasm_val_vec_t one_arg{1, &bits}, one_result{1, &out};
+  ASSERT_EQ(nullptr,
+            wasm_promising_func_call(run, &one_arg, &one_result, &pending));
+  EXPECT_TRUE(std::isnan(out.of.f32));
+  wasm_promising_func_delete(run);
+}
