+extern "C++" {
+void wasm::FuncData::InvokeJS(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  auto isolate = info.GetIsolate();
+  auto context = isolate->GetCurrentContext();
+  auto native =
+      vi::Cast<vi::JSFunction>(v8::Utils::OpenDirectHandle(*info.DataV2()));
+  auto capi = vi::direct_handle(native->shared()->wasm_capi_function_data(),
+                                reinterpret_cast<vi::Isolate*>(isolate));
+  auto self =
+      vi::Cast<vi::CppGCManaged<FuncData>>(capi->embedder_data())->ptr();
+  auto store = impl(self->store);
+  auto call = active_jspi_call;
+  ActiveJspiCall sync(nullptr);
+  const auto& params = self->type->params();
+  CHECK_EQ(params.size(), static_cast<size_t>(info.Length()));
+  auto args = vec<Val>::make_uninitialized(params.size());
+  auto results = vec<Val>::make_uninitialized(self->type->results().size());
+  own<Trap> trap;
+  for (size_t i = 0; !trap && i < params.size(); ++i)
+    trap = FromJS(store, info[static_cast<int>(i)], params[i]->kind(), args[i],
+                  true);
+  bool pending = false;
+  if (!trap) {
+    trap = self->kind == kAsync
+               ? self->InvokeAsync(args, results, call ? &pending : nullptr)
+               : CallWasmCapiFunction(*capi, args, results);
+  }
+  if (!trap && pending) {
+    v8::Local<v8::Promise::Resolver> resolver;
+    if (!v8::Promise::Resolver::New(context).ToLocal(&resolver)) return;
+    call->continuation.Reset(isolate, resolver);
+    call->suspended_type = self->type->copy();
+    info.GetReturnValue().Set(resolver->GetPromise());
+  } else if (trap) {
+    isolate->ThrowException(v8::Utils::ToLocal(impl(trap.get())->v8_object()));
+  } else {
+    // An array distinguishes a ready externref result holding a Promise from
+    // the promise returned by a genuinely pending native callback.
+    info.GetReturnValue().Set(BoxHostResults(isolate, results));
+  }
+}
