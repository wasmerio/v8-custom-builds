+          ? resolver->Reject(
+                store->context(),
+                v8::Utils::ToLocal(wasm::impl(reveal_trap(error))->v8_object()))
+          : resolver->Resolve(store->context(),
+                              BoxHostResults(isolate, call->inputs));
+  if (!settled.FromMaybe(false))
+    return JspiFailure(store, caught, "could not resume Wasm continuation");
+  return FinishTurn(call, next);
+}
