+TEST_F(WasmCapiTest, SimdHostImportFromPromisingExport) {
+  ValueType v128 = kWasmS128;
+  FunctionSig consume(0, 1, &v128);
+  FunctionSig run(0, 0, nullptr);
+  auto index = builder()->AddImport("consume", &consume);
+  uint8_t body[] = {
+      WASM_CALL_FUNCTION(index, WASM_SIMD_I8x16_SPLAT(WASM_I32V_1(42)))};
+  AddExportedFunction("run", body, sizeof(body), &run);
+  auto params = ownvec<ValType>::make(ValType::make(::wasm::ValKind::V128));
+  auto type = FuncType::make(std::move(params), ownvec<ValType>::make());
+  int visits = 0;
+  auto host = Func::make(
+      store(), type.get(),
+      [](void* env, const vec<Val>& args, vec<Val>&) -> own<Trap> {
+        ++*static_cast<int*>(env);
+        auto vector = args[0].v128();
+        const auto* bytes = reinterpret_cast<const uint8_t*>(&vector);
+        for (size_t i = 0; i < sizeof(vector); ++i) EXPECT_EQ(42, bytes[i]);
+        return nullptr;
+      },
+      &visits);
+  auto imports = vec<Extern*>::make(host.get());
+  Instantiate(imports);
+  auto* exported = reinterpret_cast<wasm_func_t*>(GetExportedFunction(0));
+  wasm_val_vec_t empty = WASM_EMPTY_VEC;
+  ASSERT_EQ(nullptr, wasm_func_call(exported, &empty, &empty));
+  EXPECT_EQ(1, visits);
+  auto* wrapper = wasm_func_promising(exported, nullptr);
+  ASSERT_NE(nullptr, wrapper);
+  wasm_pending_call_t* pending = nullptr;
+  auto* trap = wasm_promising_func_call(wrapper, &empty, &empty, &pending);
+  ASSERT_NE(nullptr, trap);
+  EXPECT_EQ(nullptr, pending);
+  EXPECT_EQ(1, visits);
+  wasm_trap_delete(trap);
+  wasm_promising_func_delete(wrapper);
+  ASSERT_EQ(nullptr, wasm_func_call(exported, &empty, &empty));
+  EXPECT_EQ(2, visits);
+}
