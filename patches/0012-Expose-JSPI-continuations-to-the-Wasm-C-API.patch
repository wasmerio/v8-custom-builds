+wasm::own<wasm::Trap> wasm::FuncData::InvokeAsync(const vec<Val>& args,
+                                                  vec<Val>& results,
+                                                  bool* pending) {
+  std::vector<wasm_val_t> borrowed(args.size());
+  for (size_t i = 0; i < args.size(); ++i) {
+    borrowed[i] = hide_val_vec(args)->data[i];
+    borrowed[i].kind = hide_valkind(type->params()[i]->kind());
+  }
+  wasm_val_vec_t typed_args{borrowed.size(), borrowed.data()};
+  auto out = hide_val_vec(results);
+  auto trap =
+      adopt_trap(async_callback.plain
+                     ? async_callback.plain(&typed_args, out, pending)
+                     : async_callback.with_env(env, &typed_args, out, pending));
+  if (!trap && !(pending && *pending)) {
+    for (size_t i = 0; i < results.size(); ++i) {
+      if (!MatchesTypedValue(impl(store), hide_val_vec(results)->data[i],
+                             type->results()[i]->kind())) {
+        return Trap::make(
+            store, Message::make_nt("incorrect suspending callback result"));
+      }
+    }
+  }
+  return trap;
+}
