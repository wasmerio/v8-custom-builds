+bool CopyTypedValues(wasm::StoreImpl* store, const wasm_val_vec_t* source,
+                     const wasm::ownvec<wasm::ValType>& types,
+                     wasm::vec<wasm::Val>* dest) {
+  if (!source || source->size != types.size() ||
+      (source->size && !source->data))
+    return false;
+  auto copy = wasm::vec<wasm::Val>::make_uninitialized(types.size());
+  for (size_t i = 0; i < types.size(); ++i) {
+    const auto& val = source->data[i];
+    if (val.kind != hide_valkind(types[i]->kind())) return false;
+    if (types[i]->is_ref() && val.of.ref) {
+      auto ref = wasm::impl(reveal_ref(val.of.ref));
+      if (ref->store() != store ||
+          (val.kind == WASM_FUNCREF &&
+           !vi::WasmExternalFunction::IsWasmExternalFunction(
+               *ref->v8_object())))
+        return false;
+    }
+    if (types[i]->is_ref()) {
+      copy[i] = wasm::Val::ref(types[i]->kind(),
+                               val.of.ref ? val.of.ref->copy() : nullptr);
+    } else {
+      copy[i] = adopt_val(val);
+    }
+  }
+  *dest = std::move(copy);
+  return true;
+}
+
+void ReturnTypedValues(wasm_jspi_call_t* call, wasm_val_vec_t* out) {
+  for (size_t i = 0; i < out->size; ++i) {
+    wasm_val_delete(&out->data[i]);
+    out->data[i] = release_val(std::move(call->returned[i]));
+  }
+}
+
+// Imports use the compiled Wasm-to-C wrapper, whereas the C function's
+// internal call target is its native callback and uses a different ABI.
+vi::DirectHandle<vi::WasmFuncRef> HostTarget(PromisingTarget* target,
+                                             const wasm::Func* func) {
+  auto isolate = wasm::impl(func)->store()->i_isolate();
+  auto factory = isolate->factory();
+  auto obj = wasm::impl(func)->v8_object();
+  auto data = obj->shared()->wasm_capi_function_data();
+  auto sig = data->internal()->sig();
+  auto wrapper = vw::GetWasmImportWrapperCache()->GetCompiled(
+      isolate, {vw::ImportCallKind::kWasmToCapi, sig,
+                static_cast<int>(sig->parameter_count()), vw::kNoSuspend});
+  target->wrappers.push_back(wrapper);
+  auto implicit = vi::direct_handle(data->internal()->implicit_arg(), isolate);
+  auto internal = factory->NewWasmInternalFunction(
+      implicit, -1, wrapper->code_pointer(), sig);
+  return factory->NewWasmFuncRef(internal, factory->wasm_func_ref_map());
+}
+
+v8::MaybeLocal<v8::Function> MakeTypedEntry(PromisingTarget* target) {
+  auto func = target->function.get();
+  auto ty = target->type.get();
+  auto store = wasm::impl(func)->store();
+  auto isolate = store->i_isolate();
+  auto factory = isolate->factory();
+  auto load_type = wasm::FuncType::make(wasm::ownvec<wasm::ValType>::make(),
+                                        ty->params().deep_copy());
+  auto save_type = wasm::FuncType::make(ty->results().deep_copy(),
+                                        wasm::ownvec<wasm::ValType>::make());
+  auto abstract_store = wasm::seal<wasm::Store>(store);
+  auto load = wasm::make_func(
+      abstract_store,
+      std::make_shared<wasm::FuncData>(abstract_store, load_type.get(),
+                                       wasm::FuncData::kLoadArguments));
+  auto save = wasm::make_func(
+      abstract_store,
+      std::make_shared<wasm::FuncData>(abstract_store, save_type.get(),
+                                       wasm::FuncData::kSaveResults));
+  auto first = HostTarget(target, load.get());
+  auto last = HostTarget(target, save.get());
+  auto exported =
+      wasm::impl(func)->v8_object()->shared()->wasm_exported_function_data();
+  vi::DirectHandle<vi::WasmExportedFunctionData> data(exported, isolate);
+  auto functions = factory->NewFixedArray(3);
+  functions->set(0, *first);
+  functions->set(1, data->func_ref());
+  functions->set(2, *last);
+  auto binding = factory->NewJSArrayWithElements(functions);
+  auto canonicalizer = vw::GetTypeCanonicalizer();
+  vw::FunctionSig void_sig(0, 0, nullptr);
+  auto entry_sig = canonicalizer->LookupFunctionSignature(
+      canonicalizer->AddRecursiveGroup(&void_sig));
+  auto guest_sig = data->internal()->sig();
+  auto& entry = store->jspi_entries[guest_sig];
+  if (!entry) {
+    const vw::CanonicalSig* calls[]{first->internal(isolate)->sig(), guest_sig,
+                                    last->internal(isolate)->sig()};
+    auto compiled = vi::compiler::CompileWasmCapiCallWrapper(
+        entry_sig, vw::kNoSuspend, calls);
+    entry = std::make_shared<vw::WasmWrapperHandle>(
+        vi::kNullAddress, entry_sig->signature_hash());
+    vw::WasmImportWrapperCache::ModificationScope scope(
+        vw::GetWasmImportWrapperCache());
+    scope.AddWrapper(std::move(compiled), vw::WasmCode::kWasmToCapiWrapper,
+                     entry_sig->signature_hash(), entry);
+  }
+  auto instance = vi::direct_handle(data->instance_data(), isolate);
+  auto implicit =
+      factory->NewWasmImportData(binding, vw::kNoSuspend, instance, entry_sig);
+  auto internal = factory->NewWasmInternalFunction(
+      implicit, data->function_index(), entry->code_pointer(), entry_sig);
+  auto ref = factory->NewWasmFuncRef(internal, factory->wasm_func_ref_map());
+  // Use the same intrinsic as WebAssembly.promising, with a private typed
+  // entry. Only the nullary prompt crosses the JavaScript calling convention.
+  auto entry_data = factory->NewWasmExportedFunctionData(
+      instance, ref, internal, vi::v8_flags.wasm_wrapper_tiering_budget,
+      vw::kNoPromise);
+  return v8::Utils::ToLocal(vi::NewPromisingWasmFunction(isolate, entry_data));
+}
